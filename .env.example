# Replace these example paths with your existing host directories.
BACKUP_DATA_DIR=/srv/yandexdisk-backup
MAIN_BACKUP_DIR=/mnt/backup/yandexdisk
MAIN_VERSIONS_DIR=/mnt/backup/yandexdisk_backup_versions/main
SECONDARY_BACKUP_DIR=/mnt/backup/yandexdisk_secondary
SECONDARY_VERSIONS_DIR=/mnt/backup/yandexdisk_backup_versions/secondary
TZ=UTC

# NFS filesystem magic; fail closed if a target falls back to local storage.
EXPECTED_FS_MAGIC=6969
INTERVAL_SECONDS=1800
HEALTH_MAX_AGE_SECONDS=3900
PREFLIGHT_TIMEOUT_SECONDS=90
MAX_RUN_SECONDS=43200
RETRY_INITIAL_SECONDS=300
RETRY_MAX_SECONDS=21600
RETENTION_DAYS=180
MAX_DELETE_SIZE=200Gi
